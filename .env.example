# HƯỚNG DẪN:
#   1. Sao chép file này thành .env.local (đã được gitignore)
#   2. Điền đầy đủ 3 giá trị bên dưới
#   3. Chạy: npm install && vercel dev
#
# KHÔNG commit file .env.local lên Git!
# ─────────────────────────────────────────────────────

# ① imgBB — Lưu trữ ảnh upload (miễn phí, vĩnh viễn)
#    → Đăng ký: https://imgbb.com
#    → Lấy key: https://api.imgbb.com
IMGBB_API_KEY=ccc6e2447db4038334e8bc14dd8f73c1
# ② Upstash Redis — Lưu dữ liệu link rút gọn (miễn phí)
